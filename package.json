{
  "name": "overlet",
  "version": "1.0.0",
  "description": "Put images, GIFs and videos on top of everything on your Windows desktop.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "electron",
    "overlay",
    "always-on-top",
    "desktop-widget",
    "windows"
  ],
  "author": "kwhyu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwhyu/overlet.git"
  },
  "bugs": {
    "url": "https://github.com/kwhyu/overlet/issues"
  },
  "homepage": "https://github.com/kwhyu/overlet#readme",
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.kwhyu.overlet",
    "productName": "Overlet",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Overlet",
      "artifactName": "Overlet-Setup-${version}.${ext}"
    },
    "extraFiles": [
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "downloadAlternateFFmpeg": true
  }
}
